<% var cfg = moduleConfig || {}; var alerts = Array.isArray(cfg.alerts) ? cfg.alerts : []; %>
<% var vMsg = typeof ytVideoMessage !== 'undefined' ? ytVideoMessage : ''; %>
<% var lMsg = typeof ytLiveMessage !== 'undefined' ? ytLiveMessage : ''; %>
<% function notifyVal(a) { if (a.onVideo && a.onLive) return 'both'; if (a.onLive) return 'live'; return 'video'; } %>

<p class="muted small">
  Add a channel by URL or <code>@handle</code> — Sylo resolves it on save. New uploads come from
  YouTube's public feed; "went live" is detected from the channel's live page (no API key needed).
  Checks run about every 3 minutes. Message placeholders: <code>{name}</code> <code>{title}</code> <code>{url}</code>.
</p>

<p class="muted small">Przy pierwszym sprawdzeniu bot zapamiętuje istniejące filmy bez wysyłania powiadomień. Później ogłasza nowe publikacje. Aktywna transmisja może zostać ogłoszona od razu. YouTube może opóźniać aktualizację feedu; błędy połączenia i wysyłki znajdziesz w konsoli jako <code>youtube-alerts</code>.</p>

<form method="POST" action="/guilds/<%= guild.id %>/m/youtube-alerts/config" hx-post="/guilds/<%= guild.id %>/m/youtube-alerts/config" hx-target="#module-config" hx-swap="outerHTML" class="stack u-mw-xl">
  <div id="yt-rows">
    <% (alerts.length ? alerts : [{ ytChannelId: '', name: '', discordChannelId: '', roleId: '', onVideo: true, onLive: false, videoMessage: '', liveMessage: '' }]).forEach(function (a, index) { %>
      <div class="tw-row card stack">
        <input type="hidden" name="yt_rowKey" value="<%= index %>" />
        <input type="hidden" name="yt_resolvedId" value="<%= a.ytChannelId || '' %>" />
        <input type="hidden" name="yt_resolvedName" value="<%= a.name || '' %>" />
        <div class="star-age">
          <div class="stack u-grow">
            <label class="small">YouTube channel <span class="muted">— URL or @handle</span></label>
            <input type="text" name="yt_input" required value="<%= a.ytChannelId ? ('https://www.youtube.com/channel/' + a.ytChannelId) : '' %>" placeholder="@MrBeast or a channel URL" />
            <% if (a.ytChannelId) { %><span class="muted small mono">resolved: <%= a.ytChannelId %></span><% } %>
          </div>
          <div class="stack u-grow">
            <label class="small">Announce in</label>
            <%- include('../../partials/chip-picker', { field: 'yt_channels_' + index, kind: 'channel', items: channels, selected: a.discordChannelIds || (a.discordChannelId ? [a.discordChannelId] : []) }) %>
          </div>
        </div>
        <div class="star-age">
          <div class="stack u-grow">
            <label class="small">Notify on</label>
            <select name="yt_notify">
              <option value="both" <%= notifyVal(a) === 'both' ? 'selected' : '' %>>New videos &amp; going live</option>
              <option value="video" <%= notifyVal(a) === 'video' ? 'selected' : '' %>>New videos only</option>
              <option value="live" <%= notifyVal(a) === 'live' ? 'selected' : '' %>>Going live only</option>
            </select>
          </div>
          <div class="stack u-grow">
            <label class="small">Ping role <span class="muted">— optional</span></label>
            <select name="yt_role">
              <option value="">— none —</option>
              <% roles.forEach(function (r) { %>
                <option value="<%= r.id %>" <%= r.id === a.roleId ? 'selected' : '' %>><%= r.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <label class="small">New-video message</label>
        <textarea name="yt_videoMessage" rows="2" maxlength="1500" placeholder="<%= uiText(vMsg) %>"><%= a.videoMessage || '' %></textarea>
        <label class="small">Went-live message</label>
        <textarea name="yt_liveMessage" rows="2" maxlength="1500" placeholder="<%= uiText(lMsg) %>"><%= a.liveMessage || '' %></textarea>
        <label class="small">When a livestream ends <span class="muted">— the went-live post only</span>
          <select name="yt_onEnd" class="u-w-field-sm">
            <option value="delete" <%= (a.onEnd || 'delete') === 'delete' ? 'selected' : '' %>>Delete the message</option>
            <option value="edit" <%= a.onEnd === 'edit' ? 'selected' : '' %>>Mark it as ended</option>
            <option value="keep" <%= a.onEnd === 'keep' ? 'selected' : '' %>>Leave it</option>
          </select>
        </label>
        <div><button type="button" class="link-btn" onclick="this.closest('.tw-row').remove()">remove</button></div>
      </div>
    <% }) %>
  </div>
  <div><button type="button" class="secondary" id="yt-add">＋ Add channel</button></div>
  <div class="u-mt-3"><button type="submit">Save</button></div>
</form>

<template id="yt-template">
  <div class="tw-row card stack">
    <input type="hidden" name="yt_rowKey" value="new" />
    <input type="hidden" name="yt_resolvedId" value="" />
    <input type="hidden" name="yt_resolvedName" value="" />
    <div class="star-age">
      <div class="stack u-grow"><label class="small">YouTube channel <span class="muted">— URL or @handle</span></label>
        <input type="text" name="yt_input" required placeholder="@MrBeast or a channel URL" /></div>
      <div class="stack u-grow"><label class="small">Announce in</label>
        <%- include('../../partials/chip-picker', { field: 'yt_channels_new', kind: 'channel', items: channels, selected: [] }) %></div>
    </div>
    <div class="star-age">
      <div class="stack u-grow"><label class="small">Notify on</label>
        <select name="yt_notify"><option value="both">New videos &amp; going live</option><option value="video">New videos only</option><option value="live">Going live only</option></select></div>
      <div class="stack u-grow"><label class="small">Ping role</label>
        <select name="yt_role"><option value="">— none —</option>
          <% roles.forEach(function (r) { %><option value="<%= r.id %>"><%= r.name %></option><% }) %></select></div>
    </div>
    <label class="small">New-video message</label>
    <textarea name="yt_videoMessage" rows="2" maxlength="1500" placeholder="<%= uiText(vMsg) %>"></textarea>
    <label class="small">Went-live message</label>
    <textarea name="yt_liveMessage" rows="2" maxlength="1500" placeholder="<%= uiText(lMsg) %>"></textarea>
    <label class="small">When a livestream ends
      <select name="yt_onEnd" class="u-w-field-sm">
        <option value="delete" selected>Delete the message</option>
        <option value="edit">Mark it as ended</option>
        <option value="keep">Leave it</option>
      </select>
    </label>
    <div><button type="button" class="link-btn" onclick="this.closest('.tw-row').remove()">remove</button></div>
  </div>
</template>
<script>
  document.getElementById('yt-add')?.addEventListener('click', function () {
    const rows = document.getElementById('yt-rows');
    const previous = [...rows.querySelectorAll('.tw-row:last-child .role-picker input[type="hidden"]')].map((input) => input.value);
    const fragment = document.getElementById('yt-template').content.cloneNode(true);
    const key = 'new_' + Date.now() + '_' + Math.random().toString(36).slice(2);
    fragment.querySelector('[name="yt_rowKey"]').value = key;
    const picker = fragment.querySelector('.role-picker');
    const config = JSON.parse(picker.getAttribute('x-data').slice('chipPicker('.length, -1));
    config.field = 'yt_channels_' + key;
    config.selected = previous;
    picker.setAttribute('x-data', 'chipPicker(' + JSON.stringify(config) + ')');
    rows.appendChild(fragment);
    rows.lastElementChild.querySelector('input[name="yt_input"]').focus();
  });
</script>
