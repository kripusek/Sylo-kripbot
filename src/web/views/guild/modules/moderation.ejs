<% var cfg = moduleConfig || {}; var rules = Array.isArray(cfg.warnThresholds) && cfg.warnThresholds.length ? cfg.warnThresholds : [{ count: 3, action: "ban", durationMinutes: 43200 }, { count: 5, action: "ban", durationMinutes: 0 }]; %>

<form method="POST" action="/guilds/<%= guild.id %>/m/moderation/config"
      hx-post="/guilds/<%= guild.id %>/m/moderation/config" hx-target="this" hx-swap="none"
      class="stack u-mw-lg">
  <label class="check">
    <input type="checkbox" name="dmOnPunish" <%= cfg.dmOnPunish !== false ? 'checked' : '' %> />
    Wyślij użytkownikowi wiadomość prywatną o karze
  </label>

  <label class="u-mt-2">Progi warnów</label>
  <p class="muted small">Domyślnie: 3 warny = ban na 30 dni, 5 warnów = ban permanentny. Warny pozostają po odbanowaniu. Obowiązuje najwyższy osiągnięty próg.</p>

  <table class="thresholds">
    <thead><tr><th>Liczba warnów</th><th>Kara</th><th>Czas (min); ban: 0 = permanentny</th><th></th></tr></thead>
    <tbody id="threshold-rows">
      <% rules.forEach(function (r) { %>
        <tr>
          <td><input type="number" name="t_count" min="1" max="100" value="<%= r.count %>" /></td>
          <td>
            <select name="t_action">
              <% thresholdActions.forEach(function (a) { %>
                <option value="<%= a %>" <%= a === r.action ? 'selected' : '' %>><%= ({ timeout: "Wyciszenie", kick: "Wyrzucenie", ban: "Ban" })[a] || a %></option>
              <% }) %>
            </select>
          </td>
          <td><input type="number" name="t_duration" min="0" value="<%= r.durationMinutes ?? 0 %>" /></td>
          <td><button type="button" class="link-btn" onclick="this.closest('tr').remove()">Usuń</button></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div><button type="button" class="secondary" id="add-threshold">+ Dodaj próg</button></div>

  <label class="u-mt-3">Usuń nieaktywne sprawy po <span class="muted small">— dniach; 0 = zachowaj na zawsze</span></label>
  <input type="number" name="infractionRetentionDays" min="0" max="3650" value="<%= Number(cfg.infractionRetentionDays) || 0 %>" />
  <p class="muted small">
    Codziennie usuwane są stare sprawy oznaczone jako usunięte lub zakończone. Aktywne warny pozostają w historii.
  </p>

  <div class="u-mt-3"><button type="submit">Zapisz</button></div>
</form>

<p class="muted small u-mt-4">
  Kanał logów moderacji ustawisz w <a href="/guilds/<%= guild.id %>/general">Ustawieniach ogólnych</a>.
  Warnami i banami zarządzasz w <a href="/guilds/<%= guild.id %>/moderation">Moderacji</a>.
</p>

<template id="threshold-template">
  <tr>
    <td><input type="number" name="t_count" min="1" max="100" value="3" /></td>
    <td>
      <select name="t_action">
        <% thresholdActions.forEach(function (a) { %><option value="<%= a %>"><%= ({ timeout: "Wyciszenie", kick: "Wyrzucenie", ban: "Ban" })[a] || a %></option><% }) %>
      </select>
    </td>
    <td><input type="number" name="t_duration" min="0" value="60" /></td>
    <td><button type="button" class="link-btn" onclick="this.closest('tr').remove()">Usuń</button></td>
  </tr>
</template>
<script>
  document.getElementById('add-threshold')?.addEventListener('click', () => {
    const tpl = document.getElementById('threshold-template');
    document.getElementById('threshold-rows').appendChild(tpl.content.cloneNode(true));
  });
</script>
