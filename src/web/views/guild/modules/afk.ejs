<% var cfg = moduleConfig || {}; var ig = Array.isArray(cfg.ignoreChannels) ? cfg.ignoreChannels : []; %>

<p class="muted small">
  Members run <code>/afk [reason]</code>. Sylo replies to anyone who mentions them, and clears the
  status automatically when they next send a message.
</p>

<form method="POST" action="/guilds/<%= guild.id %>/m/afk/config"
      hx-post="/guilds/<%= guild.id %>/m/afk/config" hx-target="#module-config" hx-swap="outerHTML"
      class="stack u-mw-lg">
  <label class="check">
    <input type="checkbox" name="setNickname" <%= cfg.setNickname !== false ? 'checked' : '' %> />
    Prefix their nickname with <code>[AFK]</code> (needs Manage Nicknames)
  </label>
  <label class="check">
    <input type="checkbox" name="mentionReply" <%= cfg.mentionReply !== false ? 'checked' : '' %> />
    Reply in-channel when an AFK member is mentioned
  </label>

  <label class="u-mt-2">Ignore channels <span class="muted small">— AFK isn't cleared or announced here</span></label>
  <%- include('../../partials/chip-picker', { field: 'ignoreChannels', kind: 'channel', items: channels, selected: ig }) %>

  <div class="u-mt-3"><button type="submit">Save</button></div>
</form>
