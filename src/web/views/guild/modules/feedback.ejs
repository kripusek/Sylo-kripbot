<% var cfg = moduleConfig || {}; %>
<p class="muted small">Publish two buttons for identified and anonymous complaints or feedback. Submissions go to the review channel. Restrict that channel to staff in Discord.</p>
<form method="POST" action="/guilds/<%= guild.id %>/m/feedback/config" hx-post="/guilds/<%= guild.id %>/m/feedback/config" hx-target="#module-config" hx-swap="outerHTML" class="stack u-mw-lg">
  <label>Panel channel</label>
  <select name="panelChannel"><option value="">— none —</option><% channels.forEach(function(c) { %><option value="<%= c.id %>" <%= c.id === cfg.panelChannel ? 'selected' : '' %>>#<%= c.name %></option><% }) %></select>
  <label>Staff review channel</label>
  <select name="reviewChannel"><option value="">— none —</option><% channels.forEach(function(c) { %><option value="<%= c.id %>" <%= c.id === cfg.reviewChannel ? 'selected' : '' %>>#<%= c.name %></option><% }) %></select>
  <label>Roles shown in member picker</label>
  <%- include('../../partials/chip-picker', { field: 'subjectRoles', kind: 'role', items: roles, selected: cfg.subjectRoles || [] }) %>
  <p class="muted small">Members choose a person with any selected role before writing feedback. Leave empty for general feedback without a person picker. Server Members Intent is required to list all eligible members.</p>
  <label>Panel title</label><input name="title" maxlength="256" value="<%= cfg.title || 'Skargi i opinie' %>" />
  <label>Panel message</label><textarea name="message" maxlength="2000" rows="4"><%= cfg.message || 'Napisz opinię lub zgłoś problem administracji.' %></textarea>
  <label>Button label</label><input name="buttonLabel" maxlength="80" value="<%= cfg.buttonLabel || 'Napisz opinię' %>" />
  <label>Anonymous button label</label><input name="anonymousButtonLabel" maxlength="80" value="<%= cfg.anonymousButtonLabel || 'Napisz anonimową opinię' %>" />
  <p class="muted small">The panel offers identified and anonymous feedback buttons. Members choose the privacy mode for each submission. Anonymous feedback omits the author's Discord username and ID from the staff message. One submission per member per minute. Submission text is sent to Discord, not stored in the bot database.</p>
  <div><button type="submit">Save</button> <button type="submit" name="action" value="publish">Save and publish panel</button></div>
</form>
