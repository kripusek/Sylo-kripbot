<% var cfg = moduleConfig || {}; %>
<p class="muted small">Create a public thread for each new member message. Bots, webhooks and messages inside threads are skipped. Older messages are not processed.</p>
<form method="POST" action="/guilds/<%= guild.id %>/m/auto-threads/config" hx-post="/guilds/<%= guild.id %>/m/auto-threads/config" hx-target="#module-config" hx-swap="outerHTML" class="stack u-mw-lg">
<label>Channels</label>
<%- include('../../partials/chip-picker', { field: 'channelIds', kind: 'channel', items: channels, selected: cfg.channelIds || [] }) %>
<label>Thread name</label><input name="nameTemplate" maxlength="100" value="<%= cfg.nameTemplate || 'Dyskusja — {author}' %>" />
<p class="muted small">Placeholders: {author} and {message}. Message text requires Message Content Intent.</p>
<label>Archive after inactivity</label><select name="autoArchiveDuration">
<% [[60,'1 hour'],[1440,'1 day'],[4320,'3 days'],[10080,'7 days']].forEach(function(a) { %><option value="<%= a[0] %>" <%= (cfg.autoArchiveDuration || 1440) === a[0] ? 'selected' : '' %>><%= a[1] %></option><% }) %>
</select><button type="submit">Save</button>
</form>
<p class="muted small">Enable the module. The bot needs View Channel, Read Message History and Create Public Threads permissions.</p>
