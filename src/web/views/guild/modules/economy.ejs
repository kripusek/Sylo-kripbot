<%
  var cfg = moduleConfig || {};
  var daily = cfg.daily || {};
  var rewards = Array.isArray(daily.rewards) && daily.rewards.length ? daily.rewards : [100, 150, 200, 250, 300, 400, 500];
  var lvl = cfg.levelRewards || {};
  var milestones = Array.isArray(lvl.milestones) ? lvl.milestones : [];
  var transfers = cfg.transfers || {};
  var shop = cfg.shop || {};
  var items = Array.isArray(shop.items) ? shop.items : [];
  var games = cfg.games || {};
  var cs2 = games.cs2 || {};
  var gameChannels = Array.isArray(games.channelIds) ? games.channelIds : [];
  var activity = cfg.activity || {};
  var amsg = activity.messages || {};
  var avoice = activity.voice || {};
  var top = typeof economyTop !== 'undefined' && Array.isArray(economyTop) ? economyTop : [];
%>

<p class="muted small">Virtual coins members earn from a daily reward and from levelling up, and spend on roles, transfers and mini-games. The coins have no real-world value.</p>

<form method="POST" action="/guilds/<%= guild.id %>/m/economy/config" hx-post="/guilds/<%= guild.id %>/m/economy/config" hx-target="#module-config" hx-swap="outerHTML">

  <details class="lvl-sec" open>
    <summary>Currency<span class="lvl-chev">▾</span></summary>
    <label class="small">Currency name</label>
    <input class="u-w-field" name="currencyName" maxlength="24" value="<%= cfg.currencyName || 'monet' %>" />
    <label class="small u-mt-2">Currency emoji</label>
    <input class="u-w-field-sm" name="currencyEmoji" maxlength="40" value="<%= cfg.currencyEmoji || '🪙' %>" />
    <label class="small u-mt-2">Starting balance</label>
    <input class="u-w-field-sm" type="number" name="startingBalance" min="0" max="1000000" value="<%= cfg.startingBalance || 0 %>" />
  </details>

  <details class="lvl-sec" open>
    <summary>Daily rewards<span class="lvl-chev">▾</span></summary>
    <p class="muted small">Members claim a reward with /ekonomia daily. Claiming on consecutive days builds a streak and moves them along the reward days below.</p>
    <label class="checkline">
      <input type="checkbox" name="daily_enabled" <%= daily.enabled !== false ? 'checked' : '' %> />
      Enable daily rewards
    </label>

    <label class="small u-mt-2">Hours between claims</label>
    <input class="u-w-field-sm" type="number" name="daily_cooldownHours" min="1" max="168" value="<%= daily.cooldownHours || 24 %>" />
    <label class="small u-mt-2">Extra hours to keep the streak</label>
    <input class="u-w-field-sm" type="number" name="daily_graceHours" min="0" max="168" value="<%= daily.graceHours != null ? daily.graceHours : 24 %>" />
    <p class="muted small">If a member waits longer than the claim interval plus these hours, their streak resets to day 1.</p>

    <label class="checkline">
      <input type="checkbox" name="daily_loop" <%= daily.loop !== false ? 'checked' : '' %> />
      Start again from day 1 after the last day
    </label>

    <label class="small u-mt-2">Reward for each day</label>
    <table class="thresholds">
      <thead><tr><th>Day</th><th>Coins</th><th></th></tr></thead>
      <tbody id="eco-days">
        <% rewards.forEach(function (amount, i) { %>
          <tr>
            <td class="eco-day-no">Day <%= i + 1 %></td>
            <td><input class="u-w-num" type="number" name="daily_reward" min="0" max="1000000000" value="<%= amount %>" /></td>
            <td><button type="button" class="link-btn eco-remove-day">remove</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div><button type="button" class="secondary" id="eco-add-day">＋ Add day</button></div>
  </details>

  <details class="lvl-sec" open>
    <summary>Level-up rewards<span class="lvl-chev">▾</span></summary>
    <p class="muted small">Pay coins when a member reaches a new level. Requires the Leveling module to be enabled.</p>
    <label class="checkline">
      <input type="checkbox" name="lvl_enabled" <%= lvl.enabled ? 'checked' : '' %> />
      Pay coins for levelling up
    </label>

    <label class="rr-mode"><input type="radio" name="lvl_mode" value="flat" <%= lvl.mode !== 'scaled' ? 'checked' : '' %> /> <span>Fixed amount for every level</span></label>
    <label class="rr-mode"><input type="radio" name="lvl_mode" value="scaled" <%= lvl.mode === 'scaled' ? 'checked' : '' %> /> <span>Amount multiplied by the level reached</span></label>
    <label class="small u-mt-2">Coins per level</label>
    <input class="u-w-field-sm" type="number" name="lvl_amount" min="0" max="1000000000" value="<%= lvl.amount != null ? lvl.amount : 50 %>" />

    <label class="small u-mt-2">Bonus at specific levels</label>
    <table class="thresholds">
      <thead><tr><th>At level</th><th>Extra coins</th><th></th></tr></thead>
      <tbody id="eco-milestones">
        <% milestones.forEach(function (m) { %>
          <tr>
            <td><input class="u-w-num" type="number" name="ms_level" min="1" max="1000" value="<%= m.level %>" /></td>
            <td><input class="u-w-num" type="number" name="ms_amount" min="1" max="1000000000" value="<%= m.amount %>" /></td>
            <td><button type="button" class="link-btn" onclick="this.closest('tr').remove()">remove</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div><button type="button" class="secondary" id="eco-add-milestone">＋ Add level bonus</button></div>

    <label class="checkline u-mt-2">
      <input type="checkbox" name="lvl_notify" <%= lvl.notify !== false ? 'checked' : '' %> />
      Post a short message when coins are paid
    </label>
  </details>

  <details class="lvl-sec" open>
    <summary>Activity rewards<span class="lvl-chev">▾</span></summary>
    <p class="muted small">Members earn coins just for being active. Each source has an optional daily limit per member (0 = no limit).</p>

    <label class="checkline">
      <input type="checkbox" name="msg_enabled" <%= amsg.enabled ? 'checked' : '' %> />
      Coins for chatting
    </label>
    <label class="small u-mt-2">Coins per payout</label>
    <input class="u-w-field-sm" type="number" name="msg_amount" min="1" max="100000" value="<%= amsg.amount || 2 %>" />
    <label class="small u-mt-2">Seconds between payouts</label>
    <input class="u-w-field-sm" type="number" name="msg_cooldownSeconds" min="5" max="3600" value="<%= amsg.cooldownSeconds || 60 %>" />
    <label class="small u-mt-2">Daily limit from chatting</label>
    <input class="u-w-field-sm" type="number" name="msg_dailyCap" min="0" max="1000000000" value="<%= amsg.dailyCap != null ? amsg.dailyCap : 500 %>" />

    <label class="checkline u-mt-3">
      <input type="checkbox" name="voice_enabled" <%= avoice.enabled ? 'checked' : '' %> />
      Coins for time in voice channels
    </label>
    <label class="small u-mt-2">Coins per minute</label>
    <input class="u-w-field-sm" type="number" name="voice_perMinute" min="1" max="100000" value="<%= avoice.perMinute || 1 %>" />
    <label class="small u-mt-2">Daily limit from voice</label>
    <input class="u-w-field-sm" type="number" name="voice_dailyCap" min="0" max="1000000000" value="<%= avoice.dailyCap != null ? avoice.dailyCap : 1000 %>" />
    <p class="muted small">Voice time only counts while the member is not alone, not deafened and not in the AFK channel. The daily limits reset when the bot restarts.</p>
  </details>

  <details class="lvl-sec" open>
    <summary>Transfers<span class="lvl-chev">▾</span></summary>
    <label class="checkline">
      <input type="checkbox" name="transfers_enabled" <%= transfers.enabled !== false ? 'checked' : '' %> />
      Let members send coins with /ekonomia przekaz
    </label>
    <label class="small u-mt-2">Minimum transfer</label>
    <input class="u-w-field-sm" type="number" name="transfers_minAmount" min="1" max="1000000000" value="<%= transfers.minAmount || 1 %>" />
    <label class="small u-mt-2">Transfer fee (%)</label>
    <input class="u-w-field-sm" type="number" name="transfers_feePercent" min="0" max="50" value="<%= transfers.feePercent || 0 %>" />
  </details>

  <details class="lvl-sec" open>
    <summary>Role shop<span class="lvl-chev">▾</span></summary>
    <p class="muted small">Members buy these roles with /kup rola. The bot needs Manage Roles and its role must be above the roles sold.</p>
    <label class="checkline">
      <input type="checkbox" name="shop_enabled" <%= shop.enabled ? 'checked' : '' %> />
      Enable the shop
    </label>
    <table class="thresholds">
      <thead><tr><th>Role</th><th>Price</th><th></th></tr></thead>
      <tbody id="eco-shop">
        <% items.forEach(function (item) { %>
          <tr>
            <td>
              <select name="shop_role">
                <% roles.forEach(function (role) { %><option value="<%= role.id %>" <%= role.id === item.roleId ? 'selected' : '' %>><%= role.name %></option><% }) %>
              </select>
            </td>
            <td><input class="u-w-num" type="number" name="shop_price" min="1" max="1000000000" value="<%= item.price %>" /></td>
            <td><button type="button" class="link-btn" onclick="this.closest('tr').remove()">remove</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div><button type="button" class="secondary" id="eco-add-item">＋ Add role</button></div>
  </details>

  <details class="lvl-sec" open>
    <summary>Games<span class="lvl-chev">▾</span></summary>
    <p class="muted small">Mini-games played for virtual coins with /gry: coinflip, guess, rock-paper-scissors, dice, slots, blackjack, poker, roulette and cups.</p>
    <label class="checkline">
      <input type="checkbox" name="games_enabled" <%= games.enabled ? 'checked' : '' %> />
      Enable games
    </label>
    <label class="small u-mt-2">Minimum bet</label>
    <input class="u-w-field-sm" type="number" name="games_minBet" min="1" max="1000000000" value="<%= games.minBet || 10 %>" />
    <label class="small u-mt-2">Maximum bet</label>
    <input class="u-w-field-sm" type="number" name="games_maxBet" min="1" max="1000000000" value="<%= games.maxBet || 1000 %>" />
    <label class="small u-mt-2">Seconds between games</label>
    <input class="u-w-field-sm" type="number" name="games_cooldownSeconds" min="0" max="600" value="<%= games.cooldownSeconds != null ? games.cooldownSeconds : 5 %>" />
    <label class="small u-mt-2">Only in these channels</label>
    <%- include('../../partials/chip-picker', { field: 'gameChannels', kind: 'channel', items: channels, selected: gameChannels }) %>
    <p class="muted small">Leave empty to allow games in every channel.</p>

    <h3 class="u-mt-4">CS2 match bets — announcements</h3>
    <p class="muted small">Where and how the result of a /gry cs2 stake is announced. Leave a message empty to use the default. Placeholders: {user} {amount} {payout} {multiplier} {map} {score} {mode} {currency}. Markdown and custom emoji work.</p>
    <label class="small u-mt-2">Announcement channel</label>
    <select class="u-w-field" name="cs2_channel">
      <option value="">— the channel where the stake was placed —</option>
      <% (typeof channels !== 'undefined' ? channels : []).forEach(function (c) { %>
        <option value="<%= c.id %>" <%= c.id === cs2.channelId ? 'selected' : '' %>>#<%= c.name %></option>
      <% }) %>
    </select>
    <label class="checkline u-mt-2">
      <input type="checkbox" name="cs2_ping" <%= cs2.ping !== false ? 'checked' : '' %> />
      Ping the player (notification)
    </label>
    <label class="small u-mt-2">"No pings" role</label>
    <select class="u-w-field" name="cs2_noping_role">
      <option value="">— none (no button) —</option>
      <% roles.forEach(function (role) { %><option value="<%= role.id %>" <%= role.id === cs2.noPingRoleId ? 'selected' : '' %>><%= role.name %></option><% }) %>
    </select>
    <p class="muted small">With a role chosen, every announcement gets a button; clicking it gives or removes the role, and members holding it are not pinged. The bot needs Manage Roles and the role must be below the bot's highest role.</p>
    <label class="small u-mt-2">Win message</label>
    <textarea name="cs2_win" rows="2" maxlength="400" placeholder="🏆 {user} wygrał mecz CS2 ({map} {score}, {mode})! Wypłata ×{multiplier}: {payout}."><%= cs2.winMessage || '' %></textarea>
    <label class="small u-mt-2">Loss message</label>
    <textarea name="cs2_loss" rows="2" maxlength="400" placeholder="💀 {user} przegrał mecz CS2 ({map} {score}, {mode}). Stawka {amount} przepadła."><%= cs2.lossMessage || '' %></textarea>
    <label class="small u-mt-2">Tie message</label>
    <textarea name="cs2_tie" rows="2" maxlength="400" placeholder="🤝 Remis w meczu CS2 ({map} {score}, {mode}) — {user} dostaje zwrot stawki: {amount}."><%= cs2.tieMessage || '' %></textarea>
    <label class="small u-mt-2">No match found (refund) message</label>
    <textarea name="cs2_expired" rows="2" maxlength="400" placeholder="⏳ Nie znalazłem meczu CS2 dla {user} — stawka {amount} wróciła na konto."><%= cs2.expiredMessage || '' %></textarea>
  </details>

  <div class="u-mt-4"><button type="submit">Save economy settings</button></div>
</form>

<details class="lvl-sec" open>
  <summary>Manage coins<span class="lvl-chev">▾</span></summary>
  <p class="muted small">Add, remove or set a member's balance by hand — handy for testing. Changes are written to the audit log.</p>
  <form method="POST" action="/guilds/<%= guild.id %>/m/economy/adjust" class="row-form">
    <input class="u-w-field" name="userId" placeholder="Member ID or @mention" required />
    <input class="u-w-num" type="number" name="amount" min="0" max="1000000000" placeholder="Amount" required />
    <button type="submit" name="action" value="add">Add</button>
    <button type="submit" name="action" value="remove" class="secondary">Remove</button>
    <button type="submit" name="action" value="set" class="secondary" data-confirm="Replace this member's balance with the amount?">Set balance</button>
  </form>
</details>

<details class="lvl-sec" open>
  <summary>Richest members<span class="lvl-chev">▾</span></summary>
  <% if (!top.length) { %>
    <p class="muted small">Nobody has any coins yet.</p>
  <% } else { %>
    <table class="thresholds">
      <thead><tr><th>#</th><th>Member</th><th>Coins</th></tr></thead>
      <tbody>
        <% top.forEach(function (row) { %>
          <tr>
            <td><%= row.rank %></td>
            <td><%= row.name %> <span class="muted small mono"><%= row.userId %></span></td>
            <td><%= row.balance.toLocaleString('en-US') %> <%= cfg.currencyEmoji || '🪙' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</details>

<template id="eco-day-template">
  <tr>
    <td class="eco-day-no">Day</td>
    <td><input class="u-w-num" type="number" name="daily_reward" min="0" max="1000000000" value="100" /></td>
    <td><button type="button" class="link-btn eco-remove-day">remove</button></td>
  </tr>
</template>
<template id="eco-milestone-template">
  <tr>
    <td><input class="u-w-num" type="number" name="ms_level" min="1" max="1000" value="10" /></td>
    <td><input class="u-w-num" type="number" name="ms_amount" min="1" max="1000000000" value="500" /></td>
    <td><button type="button" class="link-btn" onclick="this.closest('tr').remove()">remove</button></td>
  </tr>
</template>
<template id="eco-item-template">
  <tr>
    <td>
      <select name="shop_role">
        <% roles.forEach(function (role) { %><option value="<%= role.id %>"><%= role.name %></option><% }) %>
      </select>
    </td>
    <td><input class="u-w-num" type="number" name="shop_price" min="1" max="1000000000" value="1000" /></td>
    <td><button type="button" class="link-btn" onclick="this.closest('tr').remove()">remove</button></td>
  </tr>
</template>
<script>
  (function () {
    var days = document.getElementById('eco-days');
    if (!days) return;
    var dayWord = days.querySelector('.eco-day-no') ? days.querySelector('.eco-day-no').textContent.replace(/\s*\d+\s*$/, '').trim() || 'Day' : 'Day';
    function renumber() {
      days.querySelectorAll('.eco-day-no').forEach(function (cell, i) { cell.textContent = dayWord + ' ' + (i + 1); });
    }
    days.addEventListener('click', function (e) {
      if (!e.target.classList.contains('eco-remove-day')) return;
      if (days.children.length <= 1) return;
      e.target.closest('tr').remove();
      renumber();
    });
    document.getElementById('eco-add-day').addEventListener('click', function () {
      if (days.children.length >= 31) return;
      days.appendChild(document.getElementById('eco-day-template').content.cloneNode(true));
      renumber();
    });
    document.getElementById('eco-add-milestone').addEventListener('click', function () {
      document.getElementById('eco-milestones').appendChild(document.getElementById('eco-milestone-template').content.cloneNode(true));
    });
    document.getElementById('eco-add-item').addEventListener('click', function () {
      document.getElementById('eco-shop').appendChild(document.getElementById('eco-item-template').content.cloneNode(true));
    });
  })();
</script>
