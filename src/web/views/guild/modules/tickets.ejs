<% var cfg = moduleConfig || {}; var staff = Array.isArray(cfg.staffRoles) ? cfg.staffRoles : []; %>

<p class="muted small">
  Members open a ticket by sending the bot a direct message. Staff read and reply here — replies reach the member as an
  anonymous “Staff” DM. Manage the queue under <a href="/guilds/<%= guild.id %>/tickets">Tickets</a>.
</p>

<form method="POST" action="/guilds/<%= guild.id %>/m/tickets/config" hx-post="/guilds/<%= guild.id %>/m/tickets/config" hx-target="#module-config" hx-swap="outerHTML" class="stack u-mw-lg">
  <h3>Discord ticket panel</h3>
  <p class="muted small">Publish a dropdown menu. Each topic opens a private text channel in its selected category. Configure Staff roles below. Administrators can also access tickets. Closing sends a text transcript to the Ticket log channel, then deletes the ticket channel. If archiving fails, the channel is retained. Modmail retention does not delete Discord transcripts.</p>
  <label>Panel channel</label>
  <select name="panelChannel"><option value="">— none —</option>
  <% channels.forEach(function(c) { %><option value="<%= c.id %>" <%= c.id === cfg.panelChannel ? 'selected' : '' %>>#<%= c.name %></option><% }) %>
  </select>
  <label>Panel title</label><input name="panelTitle" maxlength="256" value="<%= cfg.panelTitle || 'Support tickets' %>" />
  <label>Panel message</label><textarea name="panelText" maxlength="2000" rows="3"><%= cfg.panelText || 'Choose a topic below to open a private ticket.' %></textarea>
  <label>Ticket log channel</label>
  <select name="ticketLogChannel"><option value="">— none —</option>
  <% channels.forEach(function(c) { %><option value="<%= c.id %>" <%= c.id === cfg.ticketLogChannel ? 'selected' : '' %>>#<%= c.name %></option><% }) %>
  </select>
  <h4>Ticket topics</h4>
  <p class="muted small">Add up to 25 topics. Save and publish after changes to update the Discord menu. One open channel ticket per member.</p>
  <div data-ticket-rows class="stack">
  <% var ticketRows = cfg.ticketTypes?.length ? cfg.ticketTypes : [{}]; ticketRows.forEach(function(row) { %>
    <fieldset class="stack" data-ticket-row>
      <input type="hidden" name="ticketTypeId" value="<%= row.id || '' %>" />
      <label>Topic name</label><input name="ticketLabel" maxlength="100" value="<%= row.label || '' %>" placeholder="Technical support" />
      <label>Description</label><input name="ticketDescription" maxlength="100" value="<%= row.description || '' %>" />
      <label>Destination category</label><select name="ticketCategory"><option value="">— choose a category —</option>
      <% categories.forEach(function(c) { %><option value="<%= c.id %>" <%= c.id === row.categoryId ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
      <button type="button" onclick="this.closest('[data-ticket-row]').remove()">Remove topic</button>
    </fieldset>
  <% }) %>
  </div>
  <template data-ticket-template>
    <fieldset class="stack" data-ticket-row>
      <input type="hidden" name="ticketTypeId" value="" />
      <label>Topic name</label><input name="ticketLabel" maxlength="100" placeholder="Technical support" />
      <label>Description</label><input name="ticketDescription" maxlength="100" />
      <label>Destination category</label><select name="ticketCategory"><option value="">— choose a category —</option>
      <% categories.forEach(function(c) { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
      </select>
      <button type="button" onclick="this.closest('[data-ticket-row]').remove()">Remove topic</button>
    </fieldset>
  </template>
  <div><button type="button" onclick="const form=this.closest('form'); const rows=form.querySelector('[data-ticket-rows]'); if(rows.children.length &lt; 25) rows.append(form.querySelector('[data-ticket-template]').content.cloneNode(true));">Add topic</button>
  <button type="submit" name="action" value="publish">Save and publish panel</button></div>
  <hr />
  <h3>DM tickets (modmail)</h3>
  <label>Greeting sent when a ticket opens <span class="muted small">— {server} is replaced</span></label>
  <textarea name="greeting" rows="2" placeholder="Thanks for contacting the staff of {server}…"><%= cfg.greeting || '' %></textarea>

  <label>Message sent when a ticket is closed</label>
  <textarea name="closeMessage" rows="2" placeholder="This ticket has been closed…"><%= cfg.closeMessage || '' %></textarea>

  <label>Staff notification channel <span class="muted small">— optional, pinged on new tickets/replies</span></label>
  <select name="notifyChannel">
    <option value="">— none —</option>
    <% channels.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= c.id === (cfg.notifyChannel || '') ? 'selected' : '' %>>#<%= c.name %></option>
    <% }) %>
  </select>

  <label>Staff roles <span class="muted small">— may read/reply to tickets even without Manage Server</span></label>
  <select name="staffRoles" multiple size="6">
    <% roles.forEach(function (r) { %>
      <option value="<%= r.id %>" <%= staff.includes(r.id) ? 'selected' : '' %>><%= r.name %></option>
    <% }) %>
  </select>

  <label class="check">
    <input type="checkbox" name="showMessageInAlert" <%= cfg.showMessageInAlert ? 'checked' : '' %> />
    Include the ticket's opening message in the staff notification
  </label>
  <p class="muted small">Lets staff see what a ticket is about before opening it — off by default since the message may be sensitive.</p>

  <label>Delete closed tickets after <span class="muted small">— days; 0 = keep forever</span></label>
  <input type="number" name="transcriptRetentionDays" min="0" max="3650" value="<%= Number(cfg.transcriptRetentionDays) || 0 %>" />
  <p class="muted small">
    A daily job removes closed tickets and every message in them once they are older than this. Open tickets are never
    affected.
  </p>

  <div><button type="submit">Save</button></div>
</form>
